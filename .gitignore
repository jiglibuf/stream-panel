# окружение и сборка
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/

# состояние пульта (не в git): токен, журнал, рабочие файлы
/config.json
/journal.jsonl*
/run/
*.log
*.pid
*.state

# рабочие данные модулей
/modules/*/config.json
/data/
*.bak

# профиль браузера для снимков интерфейса
.chrome-profile/

# ВНИМАНИЕ: собранный фронт (frontend/dist) и sounds/ СОБИРАЮТСЯ в репозиторий
# сознательно — так пульт запускается без установки Node (см. docs/INSTALL.md).
