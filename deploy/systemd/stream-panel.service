[Unit]
Description=Пульт стрима: управление OBS с планшета
Documentation=file:%h/obs-panel/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Каталог репозитория и его .venv берутся из %h — личных путей в юните нет.
WorkingDirectory=%h/obs-panel
# XDG_RUNTIME_DIR и PULSE_SERVER обязательны: без них pactl и pw-dump внутри
# службы не находят PipeWire и вкладка «Звук» показывает пустой список
# устройств.
Environment=XDG_RUNTIME_DIR=%t
Environment=PULSE_SERVER=unix:%t/pulse/native
# Переопределения (порт, журнал и прочее) — в этом файле, если он есть.
EnvironmentFile=-%h/.config/stream-panel/env
ExecStart=%h/obs-panel/.venv/bin/python -m server
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stream-panel

[Install]
WantedBy=default.target
